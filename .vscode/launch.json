{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "py-server\\server.py",
                "FLASK_DEBUG": "1",
                "PYTHONPATH": "${workspaceFolder}/py-server"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload",
                "--port=5003"
            ],
            "cwd": "${workspaceFolder}/py-server",
            "jinja": true,
            "autoStartBrowser": false
        }
    ]
}